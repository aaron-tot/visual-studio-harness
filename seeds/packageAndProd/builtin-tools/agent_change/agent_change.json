{
  "name": "agent_change",
  "description": "Request to switch to a different agent configuration.",
  "entry": "index.ts",
  "inputSchema": {
    "type": "object",
    "properties": {
      "suggestedAgent": {
        "type": "string",
        "description": "Agent to switch to"
      },
      "reason": {
        "type": "string",
        "description": "Why this agent is better"
      },
      "continueAfter": {
        "type": "boolean",
        "description": "Continue immediately after switch"
      }
    },
    "required": [
      "suggestedAgent",
      "reason"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "enabled": true,
  "permissionDefault": "ask"
}
