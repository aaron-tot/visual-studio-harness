{
  "name": "list",
  "description": "List designs, notes, audits, and knowledge docs. Omit feature/scope to aggregate. For knowledge docs pass a `configs` array.",
  "entry": "index.ts",
  "inputSchema": {
    "type": "object",
    "properties": {
      "feature": {
        "type": "string",
        "enum": [
          "designs",
          "notes",
          "audits",
          "knowledge"
        ]
      },
      "scope": {
        "type": "string",
        "enum": [
          "global",
          "project",
          "session"
        ]
      },
      "configs": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "extension": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "processing",
                "ready",
                "failed"
              ]
            },
            "createdBy": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "enabled": true,
  "permissionDefault": "allow"
}
